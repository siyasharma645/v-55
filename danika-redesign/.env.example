# Public site URL used for canonical, Open Graph, sitemap and JSON-LD.
# Use the original domain when this site REPLACES danikaplumbing.com.
NEXT_PUBLIC_SITE_URL=https://danikaplumbing.com

# Set to 1 after running `npm run images:fetch` to serve self-hosted images from /public/images.
NEXT_PUBLIC_LOCAL_IMAGES=0

# Where quote requests are delivered (CRM, Zapier/Make, Formspree, etc.). Receives JSON via POST.
# Until set, the form validates but tells visitors to call instead (nothing is silently dropped).
LEAD_WEBHOOK_URL=
